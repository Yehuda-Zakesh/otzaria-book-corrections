{
  "schemaVersion": 1,
  "id": "org.otzaria.community.book-corrections",
  "name": "תיקוני ספרים",
  "version": "0.3.0",
  "stability": "experimental",
  "description": "תיקון נוסח הספר בקורא של אוצריא, שמירת התיקונים ושליחתם כדיווחי שגיאות.",
  "author": "Yehuda-Zakesh",
  "homepage": "https://github.com/Yehuda-Zakesh/otzaria-book-corrections",
  "entrypoint": "index.html",
  "minAppVersion": "0.9.98",
  "sdkVersion": "1.x",
  "permissions": [
    "app.startup_contributions",
    "app.run_on_startup",
    "app.background_keep_alive",
    "reader.open",
    "reader.context_menu",
    "reader.toolbar",
    "reader.local_edit",
    "reader.highlight",
    "library.books.read",
    "library.content.read",
    "feedback.send_email",
    "events.subscribe:reader.current_ref_changed"
  ],
  "contributes": {
    "toolTab": {
      "title": "תיקוני ספרים",
      "iconName": "document_edit_24_regular",
      "defaultPinned": false
    },
    "startup": {
      "toolbarItems": [
        {
          "id": "send-book-corrections",
          "title": "שליחת תיקוני הספר",
          "icon": "send_24_regular",
          "when": { "storage": { "key": "hasPendingCorrections", "equals": true } },
          "contexts": ["reader-text"]
        },
        {
          "id": "correct-book",
          "title": "תיקון הספר בקורא",
          "icon": "document_edit_24_regular",
          "contexts": [
            "reader-text"
          ]
        }
      ],
      "contextMenuItems": [
        {
          "id": "send-book-corrections",
          "title": "שליחת תיקוני הספר",
          "icon": "send_24_regular",
          "when": { "storage": { "key": "hasPendingCorrections", "equals": true } },
          "contexts": ["reader-book", "reader-selection"]
        },
        {
          "id": "correct-book",
          "title": "תיקון הספר בקורא",
          "icon": "document_edit_24_regular",
          "contexts": [
            "reader-book",
            "reader-selection"
          ]
        }
      ],
      "activationEvents": [
        {
          "topic": "app.startup",
          "when": {
            "all": [
              {
                "not": {
                  "storage": {
                    "key": "markPendingInReader",
                    "equals": false
                  }
                }
              },
              {
                "storage": {
                  "key": "readerMarksPending",
                  "equals": true
                }
              }
            ]
          }
        },
        {
          "topic": "reader.current_ref_changed",
          "when": {
            "all": [
              {
                "not": {
                  "storage": {
                    "key": "markPendingInReader",
                    "equals": false
                  }
                }
              },
              {
                "storage": {
                  "key": "readerMarksPending",
                  "equals": true
                }
              }
            ]
          }
        }
      ],
      "keepAlive": true
    }
  }
}
