{
  "schemaVersion": 1,
  "id": "org.otzaria.community.book-corrections",
  "name": "תיקוני ספרים",
  "version": "0.1.0",
  "stability": "experimental",
  "description": "עריכת עותק של ספר והפיכת השינויים לדיווחי שגיאות לאוצריא.",
  "author": "Yehuda-Zakesh",
  "homepage": "https://github.com/Yehuda-Zakesh/otzaria-book-corrections",
  "entrypoint": "index.html",
  "minAppVersion": "0.9.98",
  "sdkVersion": "1.x",
  "permissions": [
    "app.user_email.read", "app.startup_contributions",
    "reader.open", "reader.context_menu", "library.books.read", "library.content.read",
    "network.access", "settings.read", "events.subscribe:settings.changed"
  ],
  "network": { "enabled": true, "allowlist": ["https://otzaria.org/api/reportingerrors"] },
  "contributes": {
    "toolTab": { "title": "תיקוני ספרים", "iconName": "document_edit_24_regular", "defaultPinned": false },
    "startup": {
      "contextMenuItems": [{
        "id": "correct-book", "title": "העבר את הספר לתיקון", "icon": "document_edit_24_regular",
        "contexts": ["reader-selection", "reader-page-shape-selection"], "openPlugin": true
      }]
    }
  }
}
